# Google Gemini API Key (Can also be set dynamically via Web UI)
GEMINI_API_KEY=

# App Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Whisper Configuration (Auto-detects device & RAM if left empty)
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
# Options: cpu, cuda, auto
WHISPER_DEVICE=auto
# Options: int8, float16, float32
WHISPER_COMPUTE_TYPE=int8

# Storage & Processing Limits
MAX_CONCURRENT_JOBS=2
MAX_VIDEO_DURATION_SECONDS=1800